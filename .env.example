# ===== dyTextExtractor 配置模板 =====
# 复制本文件为 .env 并填入你的密钥（.env 已被 .gitignore 忽略，不会提交）

# 豆包语音 API Key（必填）
# 获取：火山引擎控制台 → 豆包语音 → 开通「录音文件识别」→ API调用 → 创建 API Key
DOUBAO_API_KEY=

# 识别语言（可选，默认 auto 自动识别）
# 支持 auto（自动）/ zh-CN（中文）/ en-US（英文）等
# DOUBAO_LANGUAGE=auto

# 豆包语音资源 ID（可选，默认 Seed-ASR 2.0 标准版）
# 需与你在控制台开通的版本一致：
#   标准版 2.0: volc.seedasr.auc （默认）
#   极速版:      volc.bigasr.auc_turbo
# DOUBAO_RESOURCE_ID=volc.seedasr.auc

# ===== AI 文案排版（可选功能，不配置则前端隐藏该功能）=====

# DeepSeek API Key（获取：https://platform.deepseek.com/ 创建）
DEEPSEEK_API_KEY=

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek API 地址（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
